{
  "name": "culm",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --conditions=source --import tsx --test --test-concurrency=1 'scripts/__tests__/*.spec.ts' 'packages/*/__tests__/**/*.spec.ts'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --cache .",
    "format-check": "prettier --check --cache .",
    "lint": "eslint",
    "gen:scripts": "node --conditions=source --import tsx scripts/gen-scripts.ts",
    "check:layers": "node --conditions=source --import tsx scripts/check-layers.ts",
    "check:terms": "node --conditions=source --import tsx scripts/check-terms.ts",
    "parity": "node --conditions=source --import tsx --test 'packages-private/parity/__tests__/*.spec.ts'",
    "parity:setup": "npm install --no-save --no-audit --no-fund playwright@1.64.1 pixelmatch@7 pngjs@7 @types/pngjs@6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9",
    "prettier": "^3",
    "tsx": "4.23.15",
    "typescript": ">=5.7",
    "typescript-eslint": "^8"
  }
}
