// A block written as data: the opening hours. It holds no function, so it is only JSON.
{
  "$schema": "../culm.schema.json",
  "id": "openinghours",
  "version": 2,
  "name": "Opening hours",
  "category": "content",
  "guide": "A heading and the days we are open. Use it on the page that tells people where and when to come.",
  "looks": [
    {
      "id": "list",
      "name": "List",
      "tree": {
        "id": "root",
        "kind": "column",
        "name": "Opening hours",
        "slot": {},
        "children": [
          {
            "id": "accent",
            "kind": "shape",
            "name": "Accent",
            "slot": {},
            "props": {
              "geometry": { "type": "rect", "radius": 9999 },
              "fill": "brand"
            },
            "style": {
              "base": {
                "width": { "n": 56, "unit": "px" },
                "height": { "n": 5, "unit": "px" }
              }
            }
          },
          {
            "id": "heading",
            "kind": "text",
            "name": "Heading",
            "slot": {},
            "required": true,
            "props": { "level": "h2", "runs": [{ "text": "Opening hours" }] }
          },
          {
            "id": "weekdays",
            "kind": "text",
            "name": "Weekdays",
            "slot": {},
            "props": {
              "level": "p",
              "runs": [{ "text": "Monday to Friday, 7 until 3" }]
            }
          },
          {
            "id": "weekend",
            "kind": "text",
            "name": "Weekend",
            "slot": {},
            "props": {
              "level": "p",
              "runs": [{ "text": "Saturday and Sunday, 8 until 2" }]
            }
          }
        ]
      }
    }
  ],
  "settings": [
    {
      "key": "heading",
      "label": "Heading",
      "type": "text",
      "actions": [{ "do": "set", "path": "heading.props.runs" }]
    },
    {
      "key": "weekdays",
      "label": "Weekdays",
      "type": "text",
      "actions": [{ "do": "set", "path": "weekdays.props.runs" }]
    },
    {
      "key": "weekend",
      "label": "Weekend",
      "type": "text",
      "actions": [{ "do": "set", "path": "weekend.props.runs" }]
    }
  ]
}
