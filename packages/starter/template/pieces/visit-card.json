// A small card that says where we are. Pages use it and may change its note.
{
  "$schema": "../culm.schema.json",
  "id": "visitcard",
  "name": "Visit card",
  "settings": [
    {
      "key": "note",
      "label": "Note",
      "type": "text",
      "part": "line",
      "field": "text",
      "default": "Monday to Friday, 7 until 3 · Saturday and Sunday, 8 until 2"
    }
  ],
  "root": {
    "id": "card",
    "kind": "column",
    "name": "Visit",
    "style": {
      "base": { "padding": [40, 16, 40, 16], "align": "center" },
      "phone": { "padding": [24, 16, 24, 16] }
    },
    "children": [
      {
        "id": "cardinner",
        "kind": "column",
        "name": "Inner",
        "slot": { "align": "center" },
        "style": {
          "base": {
            "width": "fill",
            "maxWidth": { "n": 1100, "unit": "px" },
            "gap": 8
          }
        },
        "children": [
          {
            "id": "cardheading",
            "kind": "text",
            "name": "Heading",
            "required": true,
            "props": {
              "level": "h3",
              "textStyle": "h3",
              "runs": [{ "text": "Find us on the corner" }]
            }
          },
          {
            "id": "line",
            "kind": "text",
            "name": "Line",
            "props": {
              "level": "p",
              "textStyle": "body",
              "runs": [
                {
                  "text": "Monday to Friday, 7 until 3 · Saturday and Sunday, 8 until 2"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
