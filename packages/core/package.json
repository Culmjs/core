{
  "name": "@culmjs/core",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@culmjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./document": {
      "@culmjs/source": "./src/document/index.ts",
      "types": "./dist/document/index.d.ts",
      "default": "./dist/document/index.js"
    },
    "./style": {
      "@culmjs/source": "./src/style/index.ts",
      "types": "./dist/style/index.d.ts",
      "default": "./dist/style/index.js"
    },
    "./layout": {
      "@culmjs/source": "./src/layout/index.ts",
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout/index.js"
    },
    "./scripts": {
      "@culmjs/source": "./src/scripts/index.ts",
      "types": "./dist/scripts/index.d.ts",
      "default": "./dist/scripts/index.js"
    },
    "./registry": {
      "@culmjs/source": "./src/registry/index.ts",
      "types": "./dist/registry/index.d.ts",
      "default": "./dist/registry/index.js"
    },
    "./validate": {
      "@culmjs/source": "./src/validate/index.ts",
      "types": "./dist/validate/index.d.ts",
      "default": "./dist/validate/index.js"
    },
    "./data": {
      "@culmjs/source": "./src/data/index.ts",
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./compile": {
      "@culmjs/source": "./src/compile/index.ts",
      "types": "./dist/compile/index.d.ts",
      "default": "./dist/compile/index.js"
    },
    "./ops": {
      "@culmjs/source": "./src/ops/index.ts",
      "types": "./dist/ops/index.d.ts",
      "default": "./dist/ops/index.js"
    },
    "./internal/projection": {
      "@culmjs/source": "./src/ops/projection.ts",
      "types": "./dist/ops/projection.d.ts",
      "default": "./dist/ops/projection.js"
    },
    "./measure": {
      "@culmjs/source": "./src/measure/index.ts",
      "types": "./dist/measure/index.d.ts",
      "default": "./dist/measure/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json"
  }
}
